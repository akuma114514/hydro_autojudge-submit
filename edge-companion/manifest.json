{
  "manifest_version": 3,
  "name": "Hydro Sample Runner Bridge",
  "version": "0.3.3",
  "description": "Import Hydro and Luogu problems into VS Code; submit passing Hydro solutions through your signed-in tab.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://frp-fan.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hydro Bridge"
  }
}
